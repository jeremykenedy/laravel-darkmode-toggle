{
    "name": "jeremykenedy/laravel-darkmode-toggle",
    "description": "A standalone dark mode toggle component for Laravel with multi-framework support (Tailwind, Bootstrap 5, Bootstrap 4) and multiple frontend options (Blade, Livewire, Vue, React, Svelte).",
    "license": "MIT",
    "keywords": ["laravel", "dark-mode", "theme", "toggle", "tailwind", "bootstrap", "livewire", "vue", "react", "svelte"],
    "authors": [
        {
            "name": "Jeremy Kenedy",
            "email": "jeremykenedy@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/jeremykenedy/laravel-darkmode-toggle/issues",
        "source": "https://github.com/jeremykenedy/laravel-darkmode-toggle"
    },
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/view": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "livewire/livewire": "^3.0|^4.0",
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "pestphp/pest": "^2.0|^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^2.0|^3.0|^4.0",
        "phpstan/phpstan": "^1.11|^2.0"
    },
    "suggest": {
        "livewire/livewire": "Required only when using the Livewire frontend (^3.0|^4.0)."
    },
    "autoload": {
        "psr-4": {
            "Jeremykenedy\\LaravelDarkmodeToggle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jeremykenedy\\LaravelDarkmodeToggle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint",
        "analyse": "phpstan analyse"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Jeremykenedy\\LaravelDarkmodeToggle\\Providers\\DarkmodeToggleServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
